{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"]
    },
    "noEmit": true
  },
  "include": ["**/*.ts", "**/*.vue", ".vitepress/**/*.ts", "../src/**/*"]
}